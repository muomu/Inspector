<Project Sdk="Microsoft.NET.Sdk">

  <!--
    独立种子导入控制台项目：读 seed 目录的 JSON / Markdown，EnsureCreated 后按业务键幂等导入 SQLite。
    刻意不加入 GrowthInspector.slnx：它是数据准备工具，不参与应用构建。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与 GrowthInspector.Data 保持同一主版本，避免 SQLite provider 版本漂移。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GrowthInspector.Core\GrowthInspector.Core.csproj" />
    <ProjectReference Include="..\..\src\GrowthInspector.Data\GrowthInspector.Data.csproj" />
  </ItemGroup>

</Project>
