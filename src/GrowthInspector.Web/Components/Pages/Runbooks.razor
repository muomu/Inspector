@page "/runbooks"
@rendermode InteractiveServer
@inject IManagementService Management
@inject NavigationManager Nav

<PageTitle>运维手册 · Growth Inspector</PageTitle>

<h1>运维手册</h1>
<p class="page-subtitle">
    纯 Markdown 的长期记忆：技术栈、指标语义、告警规则、排查经验。
    通用手册自动注入同项目下所有检查单；专用手册默认不注入，被检查单显式引用后全文交给 agent。
    默认只显示未归档手册。
</p>

@if (statusMessage is not null)
{
    <p class="muted">@statusMessage</p>
}

<div class="form-row">
    <label class="checkbox-line">
        <input type="checkbox" @bind="showArchived" @bind:after="ReloadAsync" /> 显示已归档
    </label>
</div>

@if (rows.Count == 0)
{
    <div class="empty">还没有手册，先新建一份。</div>
}
else
{
    <table class="data">
        <thead>
            <tr>
                <th>标题</th>
                <th>项目</th>
                <th>类别</th>
                <th>被检查单引用</th>
                <th>更新时间</th>
                <th>状态</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in rows)
            {
                <tr>
                    <td><a href="/runbooks/@row.Id">@row.Title</a></td>
                    <td>@row.ProjectName</td>
                    <td><span class="badge">@(row.Kind == RunbookKind.General ? "通用" : "专用")</span></td>
                    <td>@row.ReferencedByChecklistCount</td>
                    <td>@row.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td><span class="badge">@(row.IsArchived ? "已归档" : "启用")</span></td>
                    <td class="actions">
                        <a href="/runbooks/@row.Id">编辑</a>
                        <button @onclick="() => ToggleArchivedAsync(row)">@(row.IsArchived ? "取消归档" : "归档")</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="panel">
    <h2>新建手册</h2>
    @if (projects.Count == 0)
    {
        <p class="muted">还没有项目，请先到 <a href="/settings">设置</a> 创建项目与环境。</p>
    }
    else
    {
        <div class="form-row">
            <label>
                项目
                <select @bind="newProjectId">
                    <option value="">请选择项目</option>
                    @foreach (var project in projects)
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </select>
            </label>
            <label>
                标题
                <input @bind="newTitle" placeholder="如：growth 核心链路巡检" />
            </label>
            <label>
                类别
                <select @bind="newKindText">
                    <option value="Specialized">专用（被引用后注入）</option>
                    <option value="General">通用（自动注入）</option>
                </select>
            </label>
            <button class="primary" @onclick="CreateAsync">创建并编辑</button>
        </div>
    }
</div>

@code {
    private List<RunbookSummaryView> rows = [];
    private List<ProjectView> projects = [];
    private string newProjectId = "";
    private string newTitle = "";
    private string newKindText = "Specialized";
    private bool showArchived;
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            projects = (await Management.ListProjectsAsync(includeArchived: false, limit: 200)).Items.ToList();
            rows = (await Management.ListRunbooksAsync(includeArchived: showArchived, limit: 200)).Items.ToList();
        }
        catch (ManagementException ex)
        {
            statusMessage = ex.Message;
        }
    }

    private async Task CreateAsync()
    {
        statusMessage = null;
        try
        {
            if (!Guid.TryParse(newProjectId, out var projectId))
            {
                statusMessage = "请先选择项目。";
                return;
            }

            if (!Enum.TryParse<RunbookKind>(newKindText, out var kind))
            {
                kind = RunbookKind.Specialized;
            }

            var runbookId = await Management.CreateRunbookAsync(
                new CreateRunbookRequest(projectId, newTitle, Kind: kind));
            Nav.NavigateTo($"/runbooks/{runbookId}");
        }
        catch (ManagementException ex)
        {
            statusMessage = ex.Message;
        }
        catch (Exception ex)
        {
            statusMessage = $"创建失败：{ex.Message}";
        }
    }

    private async Task ToggleArchivedAsync(RunbookSummaryView row)
    {
        statusMessage = null;
        try
        {
            await Management.SetRunbookArchivedAsync(row.Id, !row.IsArchived);
            statusMessage = row.IsArchived ? "手册已取消归档。" : "手册已归档。";
            await ReloadAsync();
        }
        catch (ManagementException ex)
        {
            statusMessage = ex.Message;
        }
    }
}
