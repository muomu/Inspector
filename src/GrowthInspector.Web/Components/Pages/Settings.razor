    private IEnumerable<EnvironmentView> EnvironmentsOf(string projectId)
    {
        if (!Guid.TryParse(projectId, out var id))
        {
            return [];
        }

        return environments.Where(x => x.ProjectId == id && !x.IsArchived);
    }

    private IEnumerable<EnvironmentView> EnvironmentsOf(Guid projectId)
        => environments.Where(x => x.ProjectId == projectId && !x.IsArchived);

    private string ProjectName(Guid projectId)
        => DisplayText.NameOrMissing(projects.FirstOrDefault(x => x.Id == projectId)?.Name);

    private async Task SaveLlmSettingsAsync()
    {
        await ExecuteAsync(async () =>
        {
            EnsureLlmFields();
            await Management.SaveLlmSettingsAsync(new SaveLlmSettingsRequest(llmApiKey, llmBaseUrl, llmModel));
            statusMessage = "模型接入配置已保存：新任务将使用新配置，运行中的检查单不受影响。";
            await ReloadAsync();
        });
    }

    private async Task TestLlmConnectionAsync()
    {
        statusMessage = null;
        try
        {
            EnsureLlmFields();
            isLlmBusy = true;
            StateHasChanged();

            var result = await Management.TestLlmConnectionAsync(
                new TestLlmConnectionRequest(llmApiKey, llmBaseUrl, llmModel));

            statusMessage = result.Ok
                ? result.Message
                : $"测试连接失败：{result.Message}{(result.Detail is null ? "" : $"（{result.Detail}）")}";
        }
        catch (ManagementException ex)
        {
            statusMessage = ex.Message;
        }
        catch (Exception ex)
        {
            statusMessage = $"操作失败：{ex.Message}";
        }
        finally
        {
            isLlmBusy = false;
        }
    }

    private async Task ClearLlmApiKeyAsync()
    {
        await ExecuteAsync(async () =>
        {
            await Management.ClearLlmApiKeyAsync();
            statusMessage = "API key 已清除：BaseUrl 与模型保留，执行前需要重新填写 key。";
            await ReloadAsync();
        });
    }

    /// <summary>三字段必填：首次配置时 key 不能为空；已配置时留空或保持掩码表示沿用原 key。</summary>
    private void EnsureLlmFields()
    {
        if (string.IsNullOrWhiteSpace(llmBaseUrl) || string.IsNullOrWhiteSpace(llmModel))
        {
            throw new ManagementException("BaseUrl 与模型都不能为空。");
        }

        if (!llmHasApiKey && string.IsNullOrWhiteSpace(llmApiKey))
        {
            throw new ManagementException("API key 不能为空：请填写 key 后再操作。");
        }
    }

    private async Task ExecuteAsync(Func<Task> action)
    {
        statusMessage = null;
        try
        {
            await action();
        }
        catch (ManagementException ex)
        {
            statusMessage = ex.Message;
        }
        catch (Exception ex)
        {
            statusMessage = $"操作失败：{ex.Message}";
        }
    }

    private static Guid? ParseOptionalId(string value)
        => Guid.TryParse(value, out var id) ? id : null;

    private static string? NullIfBlank(string value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
