    private async Task CreateMcpServerAsync()
    {
        await ExecuteAsync(async () =>
        {
            if (!Guid.TryParse(mcpProjectId, out var projectId))
            {
                throw new ManagementException("请选择项目。");
            }

            if (!Enum.TryParse<McpTransport>(mcpTransportText, out var transport))
            {
                transport = McpTransport.Stdio;
            }

            await Management.CreateMcpServerAsync(new CreateMcpServerRequest(
                projectId,
                mcpName,
                transport,
                ParseOptionalId(mcpEnvironmentId),
                NullIfBlank(mcpCommand),
                NullIfBlank(mcpArgumentsJson),
                NullIfBlank(mcpUrl),
                mcpIsEnabled,
                mcpTimeoutSeconds,
                mcpMaxResultBytes));

            mcpName = "";
            mcpCommand = "";
            mcpArgumentsJson = "";
            mcpUrl = "";
            mcpEnvironmentId = "";
            statusMessage = "MCP server 已登记。";
            await ReloadAsync();
        });
    }

    private void BeginEditMcpServer(McpServerView server)
    {
        editingMcpServerId = server.Id;
        editMcpProjectId = server.ProjectId;
        editMcpName = server.Name;
        editMcpTransportText = server.Transport.ToString();
        editMcpEnvironmentId = server.EnvironmentId?.ToString() ?? "";
        editMcpCommand = server.Command ?? "";
        editMcpArgumentsJson = server.ArgumentsJson ?? "";
        editMcpUrl = server.Url ?? "";
        editMcpTimeoutSeconds = server.TimeoutSeconds;
        editMcpMaxResultBytes = server.MaxResultBytes;
        editMcpIsEnabled = server.IsEnabled;
    }

    private async Task SaveMcpServerAsync()
    {
        await ExecuteAsync(async () =>
        {
            if (!Enum.TryParse<McpTransport>(editMcpTransportText, out var transport))
            {
                transport = McpTransport.Stdio;
            }

            await Management.UpdateMcpServerAsync(
                editingMcpServerId,
                new UpdateMcpServerRequest(
                    editMcpName,
                    transport,
                    ParseOptionalId(editMcpEnvironmentId),
                    NullIfBlank(editMcpCommand),
                    NullIfBlank(editMcpArgumentsJson),
                    NullIfBlank(editMcpUrl),
                    editMcpIsEnabled,
                    editMcpTimeoutSeconds,
                    editMcpMaxResultBytes));

            statusMessage = "MCP server 已保存。";
            await ReloadAsync();
        });
    }

    private void CancelEditMcpServer() => editingMcpServerId = Guid.Empty;

