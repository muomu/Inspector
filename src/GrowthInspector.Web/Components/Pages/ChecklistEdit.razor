@page "/checklists/{Id:guid}"
@rendermode InteractiveServer
@inject IManagementService Management
@inject IChecklistRunQueue RunQueue
@inject NavigationManager Nav

<PageTitle>编辑检查单 · Growth Inspector</PageTitle>

@if (!loaded)
{
    <p class="muted">加载中…</p>
}
else if (checklist is null)
{
    <h1>编辑检查单</h1>
    <p class="error-text">@statusMessage</p>
}
else
{
    <h1>编辑检查单</h1>
    <p class="page-subtitle">
        项目：@checklist.ProjectName
        <span class="badge">@(checklist.IsArchived ? "已归档" : "启用")</span>
        ｜结构化断言由框架复核，agent 只负责取证。
    </p>

    <div class="panel">
        <div class="form-row">
            <label>
                名称
                <input @bind="name" />
            </label>
            <label>
                频率
                <select @bind="frequencyText">
                    <option value="Manual">手动</option>
                    <option value="Hourly">每小时</option>
                    <option value="Daily">每天</option>
                </select>
            </label>
            <label class="checkbox-line">
                <input type="checkbox" @bind="isEnabled" /> 启用
            </label>
            <button @onclick="ToggleArchivedAsync">@(isArchived ? "取消归档" : "归档")</button>
        </div>
        <label>
            说明
            <textarea rows="2" @bind="description"></textarea>
        </label>
    </div>

    <div class="panel">
        <h2>检查项</h2>
        <p class="muted">
            判定型检查项声明结构化断言（工具名 / 参数模板 / 取值路径 / 比较符 / 阈值 / 窗口 / 级别 / RuleVersion）。
            <strong>断言成立 = 健康（Ok），不成立 = 异常。</strong>
            断言字段全部留空表示信息型，只收集证据、不参与告警。
        </p>

        @foreach (var item in itemDrafts)
        {
            <div class="panel" style="margin-top:12px;">
                <div class="form-row">
                    <label style="flex:2;">检查项名称<input @bind="item.Title" /></label>
                    <label>
                        严重级别
                        <select @bind="item.SeverityText">
                            <option value="">（信息型）</option>
                            <option value="Info">Info</option>
                            <option value="Warning">Warning</option>
                            <option value="Critical">Critical</option>
                        </select>
                    </label>
                    <label>
                        RuleVersion
                        <input type="number" @bind="item.RuleVersion" placeholder="@item.LoadedRuleVersion" />
                    </label>
                    <button class="danger" @onclick="() => RemoveItem(item)">删除</button>
                </div>
                <div class="form-row">
                    <label style="flex:1;">工具名<input @bind="item.ToolName" placeholder="如 mock__QueryMetric" /></label>
                    <label style="flex:1;">取值路径<input @bind="item.ValuePath" placeholder="$.value" /></label>
                    <label>
                        比较符
                        <select @bind="item.OperatorText">
                            <option value="">（信息型）</option>
                            <option value="Lt">&lt; 阈值</option>
                            <option value="Lte">&lt;= 阈值</option>
                            <option value="Gt">&gt; 阈值</option>
                            <option value="Gte">&gt;= 阈值</option>
                            <option value="Eq">== 阈值</option>
                            <option value="Ne">!= 阈值</option>
                            <option value="Contains">包含阈值</option>
                            <option value="NotContains">不包含阈值</option>
                        </select>
                    </label>
                    <label>阈值<input @bind="item.Threshold" /></label>
                    <label>窗口<input @bind="item.Window" placeholder="1h / 24h" /></label>
                </div>
                <div class="form-col">
                    <label>
                        参数模板（JSON 对象）
                        <textarea rows="2" @bind="item.ArgumentsTemplate" placeholder="{&quot;metric&quot;:&quot;http_p99_latency_ms&quot;}"></textarea>
                    </label>
                    <label>数据源提示<input @bind="item.DataSourceHint" /></label>
                    <label>预期<input @bind="item.Expectation" /></label>
                </div>
                <p class="muted">
                    当前规则版本 v@item.LoadedRuleVersion；RuleVersion 留空时，判据变化会自动 +1。
                    断言成立 = 健康（Ok），不成立 = 异常。
                </p>
            </div>
        }
        <button @onclick="AddItem">新增检查项</button>
    </div>

    <div class="panel">
        <h2>引用的运维手册（同项目、未归档、专用）</h2>
        @if (availableRunbooks.Count == 0)
        {
            <p class="muted">同项目下还没有可引用的专用手册，请先到 <a href="/runbooks">运维手册</a> 创建。</p>
        }
        else
        {
            @foreach (var runbook in availableRunbooks)
            {
                <label class="checkbox-line">
                    <input type="checkbox"
                           checked="@selectedRunbookIds.Contains(runbook.Id)"
                           @onchange="e => ToggleRunbook(runbook.Id, e)" />
                    @runbook.Title
                    <span class="badge">@(runbook.Kind == RunbookKind.General ? "通用" : "专用")</span>
                </label>
            }
        }
        <p class="muted">通用手册会自动注入该项目下所有检查单，不需要在这里引用。</p>
    </div>

    <div class="form-row">
        <button class="primary" @onclick="SaveAsync">保存</button>
        <label>
            执行环境
            <select @bind="runEnvironmentId">
                @foreach (var environment in environments)
                {
                    <option value="@environment.Id">@environment.Name</option>
                }
            </select>
        </label>
        <button @onclick="RunNowAsync" disabled="@isArchived">立即运行</button>
        <span class="muted">@statusMessage</span>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private sealed class ItemDraft
    {
        public Guid Id { get; set; }

        public string Title { get; set; } = "";

        public string? DataSourceHint { get; set; }

        public string? Expectation { get; set; }

        public string? ToolName { get; set; }

        public string? ArgumentsTemplate { get; set; }

        public string? ValuePath { get; set; }

        public string OperatorText { get; set; } = "";

        public string? Threshold { get; set; }

        public string? Window { get; set; }

        public string SeverityText { get; set; } = "";

        public int? RuleVersion { get; set; }

        public int LoadedRuleVersion { get; set; } = 1;

        public static ItemDraft From(ChecklistItemView view) => new()
        {
            Id = view.Id,
            Title = view.Title,
            DataSourceHint = view.DataSourceHint,
            Expectation = view.Expectation,
            ToolName = view.ToolName,
            ArgumentsTemplate = view.ArgumentsTemplate,
            ValuePath = view.ValuePath,
            OperatorText = view.Operator?.ToString() ?? "",
            Threshold = view.Threshold,
            Window = view.Window,
            SeverityText = view.Severity?.ToString() ?? "",
            RuleVersion = null,
            LoadedRuleVersion = view.RuleVersion,
        };
    }

    private bool loaded;
    private ChecklistView? checklist;
    private string name = "";
    private string description = "";
    private string frequencyText = "Manual";
    private bool isEnabled;
    private bool isArchived;
    private List<ItemDraft> itemDrafts = [];
    private List<Guid> removedItemIds = [];
    private List<RunbookSummaryView> availableRunbooks = [];
    private HashSet<Guid> selectedRunbookIds = [];
    private List<EnvironmentView> environments = [];
    private string runEnvironmentId = "";
    private string? statusMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loaded = false;
        statusMessage = null;
        try
        {
            checklist = await Management.GetChecklistAsync(Id);
            if (checklist is null)
            {
                loaded = true;
                statusMessage = "检查单不存在或已被清理。";
                return;
            }

            name = checklist.Name;
            description = checklist.Description ?? "";
            frequencyText = checklist.Frequency.ToString();
            isEnabled = checklist.IsEnabled;
            isArchived = checklist.IsArchived;

            itemDrafts = (await Management.ListChecklistItemsAsync(Id))
                .Items
                .Select(ItemDraft.From)
                .ToList();
            removedItemIds = [];

            var references = await Management.ListChecklistRunbookRefsAsync(Id);
            selectedRunbookIds = references.Select(x => x.RunbookId).ToHashSet();
            availableRunbooks = (await Management.ListAssignableRunbooksAsync(Id)).ToList();

            environments = (await Management.ListEnvironmentsAsync(
                projectId: checklist.ProjectId,
                limit: 200)).Items.ToList();

            runEnvironmentId = environments.FirstOrDefault(x => x.IsDefault)?.Id.ToString()
                ?? environments.FirstOrDefault()?.Id.ToString()
                ?? "";
        }
        catch (ManagementException ex)
        {
            statusMessage = ex.Message;
        }

        loaded = true;
    }

    private void AddItem() => itemDrafts.Add(new ItemDraft());

    private void RemoveItem(ItemDraft item)
    {
        itemDrafts.Remove(item);
        if (item.Id != Guid.Empty)
        {
            removedItemIds.Add(item.Id);
        }
    }

    private void ToggleRunbook(Guid runbookId, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            selectedRunbookIds.Add(runbookId);
        }
        else
        {
            selectedRunbookIds.Remove(runbookId);
        }
    }

    private async Task<bool> SaveAsync()
    {
        statusMessage = null;
        if (checklist is null)
        {
            statusMessage = "检查单不存在。";
            return false;
        }

        try
        {
            if (!Enum.TryParse<ChecklistFrequency>(frequencyText, out var frequency))
            {
                frequency = ChecklistFrequency.Manual;
            }

            await Management.UpdateChecklistAsync(
                Id,
                new UpdateChecklistRequest(
                    name,
                    NullIfBlank(description),
                    frequency,
                    isEnabled));

            foreach (var removedId in removedItemIds)
            {
                await Management.SetChecklistItemArchivedAsync(removedId, true);
            }

            removedItemIds.Clear();

            var sortOrder = 0;
            foreach (var draft in itemDrafts)
            {
                if (string.IsNullOrWhiteSpace(draft.Title))
                {
                    continue;
                }

                var input = new ChecklistItemInput(
                    draft.Title,
                    NullIfBlank(draft.DataSourceHint),
                    NullIfBlank(draft.Expectation),
                    NullIfBlank(draft.ToolName),
                    NullIfBlank(draft.ArgumentsTemplate),
                    NullIfBlank(draft.ValuePath),
                    ParseOperator(draft.OperatorText),
                    NullIfBlank(draft.Threshold),
                    NullIfBlank(draft.Window),
                    ParseSeverity(draft.SeverityText),
                    draft.RuleVersion);

                if (draft.Id == Guid.Empty)
                {
                    draft.Id = await Management.CreateChecklistItemAsync(
                        new CreateChecklistItemRequest(Id, input, sortOrder));
                }
                else
                {
                    await Management.UpdateChecklistItemAsync(
                        draft.Id,
                        new UpdateChecklistItemRequest(input, sortOrder));
                }

                sortOrder++;
            }

            var existingRefs = (await Management.ListChecklistRunbookRefsAsync(Id))
                .Select(x => x.RunbookId)
                .ToHashSet();

            foreach (var runbookId in existingRefs.Except(selectedRunbookIds))
            {
                await Management.RemoveChecklistRunbookRefAsync(Id, runbookId);
            }

            foreach (var runbookId in selectedRunbookIds.Except(existingRefs))
            {
                await Management.AddChecklistRunbookRefAsync(Id, runbookId);
            }

            await LoadAsync();
            statusMessage = $"已保存 {DateTimeOffset.Now:HH:mm:ss}";
            return true;
        }
        catch (ManagementException ex)
        {
            statusMessage = ex.Message;
            return false;
        }
        catch (Exception ex)
        {
            statusMessage = $"保存失败：{ex.Message}";
            return false;
        }
    }

    private async Task ToggleArchivedAsync()
    {
        if (checklist is null)
        {
            return;
        }

        try
        {
            await Management.SetChecklistArchivedAsync(Id, !isArchived);
            isArchived = !isArchived;
            statusMessage = isArchived ? "检查单已归档。" : "检查单已取消归档。";
        }
        catch (ManagementException ex)
        {
            statusMessage = ex.Message;
        }
    }

    private async Task RunNowAsync()
    {
        if (!await SaveAsync())
        {
            return;
        }

        if (!Guid.TryParse(runEnvironmentId, out var environmentId))
        {
            statusMessage = "请先选择执行环境（到设置里创建）。";
            return;
        }

        try
        {
            await RunQueue.EnqueueAsync(ChecklistTrigger.Manual, Id, environmentId);
            statusMessage = "已加入执行队列，稍后到执行历史查看结果。";
        }
        catch (Exception ex)
        {
            statusMessage = $"加入执行队列失败：{ex.Message}";
        }
    }

    private static ComparisonOperator? ParseOperator(string? text)
        => Enum.TryParse<ComparisonOperator>(text, out var value) ? value : null;

    private static Severity? ParseSeverity(string? text)
        => Enum.TryParse<Severity>(text, out var severity) ? severity : null;

    private static string? NullIfBlank(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
