@page "/checklists/{Id:guid}"
@layout DesignLayout
@rendermode InteractiveServer
@inject IManagementService Management
@inject IChecklistRunQueue RunQueue
@inject WorkspaceContextService Workspace
@inject NavigationManager Nav

<PageTitle>@PageHeading · Growth Inspector</PageTitle>

<nav class="breadcrumb" aria-label="面包屑">
    <a href="@ChecklistsHref">检查单</a>
    <span class="breadcrumb__sep" aria-hidden="true">/</span>
    <span>编辑</span>
</nav>

<header class="page-head">
    <div class="page-head__main">
        <p class="kicker">体系 · 检查单</p>
        <h1 class="page-title">@PageHeading</h1>
        @if (checklist is not null)
        {
            <p class="page-meta">
                <span>@checklist.ProjectName</span>
                <span>@DisplayText.FrequencyText(checklist.Frequency)</span>
                <span>@(isEnabled ? "已启用" : "已停用")</span>
                <span>
                    @if (isArchived)
                    {
                        <span class="chip">已归档</span>
                    }
                    else
                    {
                        <span class="chip chip--ok">启用</span>
                    }
                </span>
            </p>
        }
    </div>
    <div class="page-head__actions">
        <a class="btn btn--quiet" href="@ChecklistsHref">返回列表</a>
        @if (checklist is not null)
        {
            <button type="button" class="btn btn--quiet" @onclick="ToggleArchivedAsync">
                @(isArchived ? "取消归档" : "归档")
            </button>
        }
    </div>
</header>

<p class="page-lede">
    检查项是自然语言描述：正文写清查什么、什么算健康、异常先看哪；执行 agent 按正文取证并自行判定。
</p>

@if (!loaded)
{
    <p class="note">加载中…</p>
}
else if (checklist is null)
{
    <div class="empty">
        <span class="empty__glyph" aria-hidden="true">◇</span>
        <h2 class="empty__title">检查单不存在</h2>
        <p class="empty__copy">@statusMessage</p>
        <p class="empty__copy"><a href="@ChecklistsHref">返回检查单列表</a></p>
    </div>
}
else
{
    <section class="section" aria-labelledby="s-basic">
        <div class="section__head">
            <span class="section__index">§ 01</span>
            <h2 class="section__title" id="s-basic">基本信息</h2>
            <span class="section__meta">@DisplayText.FrequencyText(checklist.Frequency)</span>
        </div>
        <div class="section__body">
            <div class="panel">
                <div class="form-row">
                    <label class="field">
                        <span class="field__label">名称</span>
                        <input class="input" @bind="name" />
                    </label>
                    <label class="field">
                        <span class="field__label">频率</span>
                        <select class="select" @bind="frequencyText">
                            <option value="Manual">手动</option>
                            <option value="Hourly">每小时</option>
                            <option value="Daily">每天</option>
                        </select>
                    </label>
                    <div class="field">
                        <span class="field__label">启用</span>
                        <label class="checkbox-line">
                            <input type="checkbox" @bind="isEnabled" /> 启用该检查单
                        </label>
                    </div>
                </div>
                <div class="form-col">
                    <label class="field">
                        <span class="field__label">说明</span>
                        <textarea class="textarea" rows="2" @bind="description"></textarea>
                    </label>
                </div>
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="s-items">
        <div class="section__head">
            <span class="section__index">§ 02</span>
            <h2 class="section__title" id="s-items">检查项</h2>
            <span class="section__meta">@itemDrafts.Count 个检查项</span>
        </div>
        <div class="section__body">
            <div class="panel">
                <p class="panel__copy">
                    检查项用自然语言描述：标题 + 正文（查什么 / 什么算健康 / 异常先看哪）+ 严重级别。
                    <strong>执行 agent 按正文取证并自行判定。</strong>
                </p>
                @foreach (var item in itemDrafts)
                {
                    <div class="item-block">
                        <div class="item-block__head">
                            <span class="item-block__index">检查项 @(itemDrafts.IndexOf(item) + 1)</span>
                            <button type="button" class="btn btn--quiet" @onclick="() => RemoveItem(item)">删除</button>
                        </div>
                        <div class="form-row">
                            <label class="field field--wide">
                                <span class="field__label">检查项名称</span>
                                <input class="input" @bind="item.Title" />
                            </label>
                            <label class="field">
                                <span class="field__label">严重级别</span>
                                <select class="select" @bind="item.SeverityText">
                                    <option value="Warning">Warning</option>
                                    <option value="Critical">Critical</option>
                                    <option value="Info">Info</option>
                                </select>
                            </label>
                        </div>
                        <div class="form-col">
                            <label class="field">
                                <span class="field__label">正文（查什么 / 什么算健康 / 异常先看哪）</span>
                                <textarea class="textarea" rows="5" @bind="item.Body"></textarea>
                            </label>
                        </div>
                    </div>
                }
                <div class="actions">
                    <button type="button" class="btn" @onclick="AddItem">新增检查项</button>
                </div>
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="s-runbooks">
        <div class="section__head">
            <span class="section__index">§ 03</span>
            <h2 class="section__title" id="s-runbooks">引用手册</h2>
            <span class="section__meta">@selectedRunbookIds.Count 份已引用</span>
        </div>
        <div class="section__body">
            <div class="panel">
                <p class="panel__copy">
                    同项目、未归档、专用手册；通用手册会自动注入该项目下所有检查单，不需要在这里引用。
                </p>
                @if (availableRunbooks.Count == 0)
                {
                    <p class="panel__copy">同项目下还没有可引用的专用手册，请先到 <a href="@RunbooksHref">运维手册</a> 创建。</p>
                }
                else
                {
                    <div class="check-list">
                        @foreach (var runbook in availableRunbooks)
                        {
                            <label class="checkbox-line">
                                <input type="checkbox"
                                       checked="@selectedRunbookIds.Contains(runbook.Id)"
                                       @onchange="e => ToggleRunbook(runbook.Id, e)" />
                                <span>@runbook.Title</span>
                                <span class="chip">@DisplayText.RunbookKindText(runbook.Kind)</span>
                            </label>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <div class="actions">
        <button type="button" class="btn btn--primary" @onclick="SaveAsync">保存</button>
        <div class="field">
            <span class="field__label">执行环境</span>
            <select class="select" @bind="runEnvironmentId">
                @foreach (var environment in environments)
                {
                    <option value="@environment.Id">@environment.Name</option>
                }
            </select>
        </div>
        <button type="button" class="btn" @onclick="RunNowAsync" disabled="@isArchived">立即运行</button>
        <span class="note">@statusMessage</span>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private sealed class ItemDraft
    {
        public Guid Id { get; set; }

        public string Title { get; set; } = "";

        public string Body { get; set; } = "";

        public string SeverityText { get; set; } = "Warning";

        public static ItemDraft From(ChecklistItemView view) => new()
        {
            Id = view.Id,
            Title = view.Title,
            Body = view.Body,
            SeverityText = view.Severity?.ToString() ?? "Warning",
        };
    }

    private WorkspaceContext workspace = WorkspaceContext.Empty;
    private bool loaded;
    private ChecklistView? checklist;
    private string name = "";
    private string description = "";
    private string frequencyText = "Manual";
    private bool isEnabled;
    private bool isArchived;
    private List<ItemDraft> itemDrafts = [];
    private List<Guid> removedItemIds = [];
    private List<RunbookSummaryView> availableRunbooks = [];
    private HashSet<Guid> selectedRunbookIds = [];
    private List<EnvironmentView> environments = [];
    private string runEnvironmentId = "";
    private string? statusMessage;

    private string ContextQuery => workspace.QuerySuffix;
    private string ChecklistsHref => $"/checklists{ContextQuery}";
    private string RunbooksHref => $"/runbooks{ContextQuery}";
    private string PageHeading => string.IsNullOrWhiteSpace(checklist?.Name) ? "编辑检查单" : checklist!.Name;

    protected override async Task OnParametersSetAsync()
    {
        await ResolveWorkspaceAsync();
        await LoadAsync();
    }

    private async Task ResolveWorkspaceAsync()
    {
        try
        {
            workspace = await Workspace.ResolveAsync(WorkspaceContextService.ReadQueryValue(Nav));
        }
        catch
        {
            workspace = WorkspaceContext.Empty;
        }
    }

    private async Task LoadAsync()
    {
        loaded = false;
        statusMessage = null;
        try
        {
            checklist = await Management.GetChecklistAsync(Id);
            if (checklist is null)
            {
                loaded = true;
                statusMessage = "检查单不存在或已被清理。";
                return;
            }

            name = checklist.Name;
            description = checklist.Description ?? "";
            frequencyText = checklist.Frequency.ToString();
            isEnabled = checklist.IsEnabled;
            isArchived = checklist.IsArchived;

            itemDrafts = (await Management.ListChecklistItemsAsync(Id))
                .Items
                .Select(ItemDraft.From)
                .ToList();
            removedItemIds = [];

            var references = (await Management.ListChecklistRunbookRefsAsync(Id)).Items;
            selectedRunbookIds = references.Select(x => x.RunbookId).ToHashSet();
            availableRunbooks = (await Management.ListAssignableRunbooksAsync(Id)).ToList();

            environments = (await Management.ListEnvironmentsAsync(
                projectId: checklist.ProjectId,
                limit: 200)).Items.ToList();

            runEnvironmentId = environments.FirstOrDefault(x => x.IsDefault)?.Id.ToString()
                ?? environments.FirstOrDefault()?.Id.ToString()
                ?? "";
        }
        catch (ManagementException ex)
        {
            statusMessage = ex.Message;
        }
        catch (Exception ex)
        {
            statusMessage = $"加载失败：{ex.Message}";
        }

        loaded = true;
    }

    private void AddItem() => itemDrafts.Add(new ItemDraft());

    private void RemoveItem(ItemDraft item)
    {
        itemDrafts.Remove(item);
        if (item.Id != Guid.Empty)
        {
            removedItemIds.Add(item.Id);
        }
    }

    private void ToggleRunbook(Guid runbookId, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            selectedRunbookIds.Add(runbookId);
        }
        else
        {
            selectedRunbookIds.Remove(runbookId);
        }
    }

    private async Task<bool> SaveAsync()
    {
        statusMessage = null;
        if (checklist is null)
        {
            statusMessage = "检查单不存在。";
            return false;
        }

        try
        {
            if (!Enum.TryParse<ChecklistFrequency>(frequencyText, out var frequency))
            {
                frequency = ChecklistFrequency.Manual;
            }

            await Management.UpdateChecklistAsync(
                Id,
                new UpdateChecklistRequest(
                    name,
                    NullIfBlank(description),
                    frequency,
                    isEnabled));

            foreach (var removedId in removedItemIds)
            {
                await Management.SetChecklistItemArchivedAsync(removedId, true);
            }

            removedItemIds.Clear();

            var sortOrder = 0;
            foreach (var draft in itemDrafts)
            {
                if (string.IsNullOrWhiteSpace(draft.Title))
                {
                    continue;
                }

                var input = new ChecklistItemInput(
                    draft.Title,
                    draft.Body,
                    ParseSeverity(draft.SeverityText));

                if (draft.Id == Guid.Empty)
                {
                    draft.Id = await Management.CreateChecklistItemAsync(
                        new CreateChecklistItemRequest(Id, input, sortOrder));
                }
                else
                {
                    await Management.UpdateChecklistItemAsync(
                        draft.Id,
                        new UpdateChecklistItemRequest(input, sortOrder));
                }

                sortOrder++;
            }

            var existingRefs = (await Management.ListChecklistRunbookRefsAsync(Id)).Items
                .Select(x => x.RunbookId)
                .ToHashSet();

            foreach (var runbookId in existingRefs.Except(selectedRunbookIds))
            {
                await Management.RemoveChecklistRunbookRefAsync(Id, runbookId);
            }

            foreach (var runbookId in selectedRunbookIds.Except(existingRefs))
            {
                await Management.AddChecklistRunbookRefAsync(Id, runbookId);
            }

            await LoadAsync();
            statusMessage = $"已保存 {DateTimeOffset.Now:HH:mm:ss}";
            return true;
        }
        catch (ManagementException ex)
        {
            statusMessage = ex.Message;
            return false;
        }
        catch (Exception ex)
        {
            statusMessage = $"保存失败：{ex.Message}";
            return false;
        }
    }

    private async Task ToggleArchivedAsync()
    {
        if (checklist is null)
        {
            return;
        }

        try
        {
            await Management.SetChecklistArchivedAsync(Id, !isArchived);
            isArchived = !isArchived;
            statusMessage = isArchived ? "检查单已归档。" : "检查单已取消归档。";
        }
        catch (ManagementException ex)
        {
            statusMessage = ex.Message;
        }
    }

    private async Task RunNowAsync()
    {
        if (!await SaveAsync())
        {
            return;
        }

        if (!Guid.TryParse(runEnvironmentId, out var environmentId))
        {
            statusMessage = "请先选择执行环境（到设置里创建）。";
            return;
        }

        try
        {
            await RunQueue.EnqueueAsync(ChecklistTrigger.Manual, Id, environmentId);
            statusMessage = "已加入执行队列，稍后到执行历史查看结果。";
        }
        catch (Exception ex)
        {
            statusMessage = $"加入执行队列失败：{ex.Message}";
        }
    }

    private static Severity? ParseSeverity(string? text)
        => Enum.TryParse<Severity>(text, out var severity) ? severity : null;

    private static string? NullIfBlank(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
