@page "/runbooks/{Id:guid}"
@rendermode InteractiveServer
@inject IDbContextFactory<GrowthInspectorDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>编辑手册 · Growth Inspector</PageTitle>

@if (runbook is null)
{
    <p class="muted">加载中…</p>
}
else
{
    <h1>编辑手册</h1>
    <p class="page-subtitle">
        项目：@projectName
        <span class="muted">｜手册只承载知识，不承载可执行判定；被以下 @referencedByCount 张检查单引用。</span>
    </p>

    <div class="form-col">
        <label>
            标题
            <input @bind="runbook.Title" />
        </label>
        <label>
            正文（Markdown）
            <textarea class="markdown-editor" rows="24" @bind="runbook.Body"></textarea>
        </label>
    </div>

    <div class="form-row">
        <button class="primary" @onclick="SaveAsync">保存</button>
        <button class="danger" @onclick="DeleteAsync">删除</button>
        <span class="muted">@statusMessage</span>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Runbook? runbook;
    private string projectName = "";
    private int referencedByCount;
    private string? statusMessage;

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        runbook = await db.Runbooks
            .AsNoTracking()
            .SingleOrDefaultAsync(x => x.Id == Id);

        if (runbook is null)
        {
            return;
        }

        projectName = await db.Projects
            .Where(x => x.Id == runbook.ProjectId)
            .Select(x => x.Name)
            .SingleAsync();

        referencedByCount = await db.ChecklistRunbookRefs.CountAsync(x => x.RunbookId == Id);
    }

    private async Task SaveAsync()
    {
        if (runbook is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(runbook.Title))
        {
            statusMessage = "标题不能为空。";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Runbooks.SingleOrDefaultAsync(x => x.Id == Id);
        if (entity is null)
        {
            statusMessage = "手册已不存在。";
            return;
        }

        entity.Title = runbook.Title.Trim();
        entity.Body = runbook.Body;
        entity.UpdatedAt = DateTimeOffset.UtcNow;
        await db.SaveChangesAsync();

        statusMessage = $"已保存 {DateTimeOffset.Now:HH:mm:ss}";
    }

    private async Task DeleteAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Runbooks.SingleOrDefaultAsync(x => x.Id == Id);
        if (entity is null)
        {
            Nav.NavigateTo("/runbooks");
            return;
        }

        db.Runbooks.Remove(entity);
        await db.SaveChangesAsync();
        Nav.NavigateTo("/runbooks");
    }
}
