@page "/checklists"
@rendermode InteractiveServer
@inject IManagementService Management
@inject NavigationManager Nav

<PageTitle>检查单 · Growth Inspector</PageTitle>

<h1>检查单</h1>
<p class="page-subtitle">
    一次可调度执行的单元：一张检查单一个频率，引用同项目下未归档的专用手册，包含多个检查项；
    执行时按环境创建 run 并写快照。默认只显示未归档检查单。
</p>

@if (statusMessage is not null)
{
    <p class="muted">@statusMessage</p>
}

<div class="form-row">
    <label class="checkbox-line">
        <input type="checkbox" @bind="showArchived" @bind:after="ReloadAsync" /> 显示已归档
    </label>
</div>

@if (rows.Count == 0)
{
    <div class="empty">还没有检查单，先新建一张。</div>
}
else
{
    <table class="data">
        <thead>
            <tr>
                <th>名称</th>
                <th>项目</th>
                <th>频率</th>
                <th>启用</th>
                <th>检查项</th>
                <th>引用手册</th>
                <th>最近运行</th>
                <th>状态</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in rows)
            {
                <tr>
                    <td><a href="/checklists/@row.Id">@row.Name</a></td>
                    <td>@row.ProjectName</td>
                    <td>@FrequencyText(row.Frequency)</td>
                    <td>@(row.IsEnabled ? "是" : "否")</td>
                    <td>@row.ItemCount</td>
                    <td>@row.RunbookRefCount</td>
                    <td>@(row.LastRunAt is null ? "-" : row.LastRunAt.Value.ToLocalTime().ToString("MM-dd HH:mm"))</td>
                    <td><span class="badge">@(row.IsArchived ? "已归档" : "启用")</span></td>
                    <td class="actions">
                        <a href="/checklists/@row.Id">编辑</a>
                        <button @onclick="() => ToggleEnabledAsync(row)">@(row.IsEnabled ? "停用" : "启用")</button>
                        <button @onclick="() => ToggleArchivedAsync(row)">@(row.IsArchived ? "取消归档" : "归档")</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="panel">
    <h2>新建检查单</h2>
    @if (projects.Count == 0)
    {
        <p class="muted">还没有项目，请先到 <a href="/settings">设置</a> 创建项目与环境。</p>
    }
    else
    {
        <div class="form-row">
            <label>
                项目
                <select @bind="newProjectId">
                    <option value="">请选择项目</option>
                    @foreach (var project in projects)
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </select>
            </label>
            <label>
                名称
                <input @bind="newName" placeholder="如：growth 核心链路巡检" />
            </label>
            <label>
                频率
                <select @bind="newFrequencyText">
                    <option value="Manual">手动</option>
                    <option value="Hourly">每小时</option>
                    <option value="Daily">每天</option>
                </select>
            </label>
            <button class="primary" @onclick="CreateAsync">创建并编辑</button>
        </div>
    }
</div>

@code {
    private List<ChecklistView> rows = [];
    private List<ProjectView> projects = [];
    private string newProjectId = "";
    private string newName = "";
    private string newFrequencyText = "Manual";
    private bool showArchived;
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            projects = (await Management.ListProjectsAsync(includeArchived: false, limit: 200)).Items.ToList();
            rows = (await Management.ListChecklistsAsync(includeArchived: showArchived, limit: 200)).Items.ToList();
        }
        catch (ManagementException ex)
        {
            statusMessage = ex.Message;
        }
    }

    private async Task ToggleEnabledAsync(ChecklistView row)
    {
        await ExecuteAsync(async () =>
        {
            await Management.UpdateChecklistAsync(
                row.Id,
                new UpdateChecklistRequest(row.Name, row.Description, row.Frequency, !row.IsEnabled));
            await ReloadAsync();
        });
    }

    private async Task ToggleArchivedAsync(ChecklistView row)
    {
        await ExecuteAsync(async () =>
        {
            await Management.SetChecklistArchivedAsync(row.Id, !row.IsArchived);
            statusMessage = row.IsArchived ? "检查单已取消归档。" : "检查单已归档。";
            await ReloadAsync();
        });
    }

    private async Task CreateAsync()
    {
        await ExecuteAsync(async () =>
        {
            if (!Guid.TryParse(newProjectId, out var projectId))
            {
                throw new ManagementException("请先选择项目。");
            }

            if (!Enum.TryParse<ChecklistFrequency>(newFrequencyText, out var frequency))
            {
                frequency = ChecklistFrequency.Manual;
            }

            var id = await Management.CreateChecklistAsync(new CreateChecklistRequest(
                projectId,
                newName,
                Frequency: frequency));

            Nav.NavigateTo($"/checklists/{id}");
        });
    }

    private async Task ExecuteAsync(Func<Task> action)
    {
        statusMessage = null;
        try
        {
            await action();
        }
        catch (ManagementException ex)
        {
            statusMessage = ex.Message;
        }
        catch (Exception ex)
        {
            statusMessage = $"操作失败：{ex.Message}";
        }
    }

    private static string FrequencyText(ChecklistFrequency frequency) => frequency switch
    {
        ChecklistFrequency.Hourly => "每小时",
        ChecklistFrequency.Daily => "每天",
        _ => "手动",
    };
}
