@page "/checklists"
@layout DesignLayout
@rendermode InteractiveServer
@inject IManagementService Management
@inject WorkspaceContextService Workspace
@inject NavigationManager Nav

<PageTitle>检查单 · Growth Inspector</PageTitle>

<header class="page-head">
    <div class="page-head__main">
        <p class="kicker">体系 · 检查单</p>
        <h1 class="page-title">检查单</h1>
        <p class="page-meta">
            <span>@ScopeLabel</span>
            <span>@rows.Count 张</span>
            <span>启用 @EnabledCount 张</span>
            <span>@ItemCount 个检查项</span>
        </p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--quiet" href="#new-checklist">新建检查单</a>
    </div>
</header>

<p class="page-lede">
    一次可调度执行的单元：一张检查单一个频率，引用同项目下未归档的专用手册，包含多个检查项；
    执行时按环境创建 run 并写快照。默认只显示未归档检查单。
</p>

@if (statusMessage is not null)
{
    <p class="alert-line" role="status"><strong>提示</strong><span>@statusMessage</span></p>
}

<div class="toolbar">
    <label class="checkbox-line">
        <input type="checkbox" @bind="showArchived" @bind:after="ReloadAsync" /> 显示已归档
    </label>
</div>

@if (rows.Count == 0)
{
    <div class="empty">
        <span class="empty__glyph" aria-hidden="true">◇</span>
        <h2 class="empty__title">还没有检查单</h2>
        <p class="empty__copy">先新建一张检查单，再添加检查项并手动触发第一轮执行。</p>
    </div>
}
else
{
    <div class="table-wrap" role="region" aria-label="检查单列表" tabindex="0">
        <table class="table table--wide">
            <caption class="sr-only">检查单的名称、项目、频率、检查项、引用手册、最近运行与状态</caption>
            <thead>
                <tr>
                    <th scope="col">名称</th>
                    <th scope="col">项目</th>
                    <th scope="col">频率</th>
                    <th scope="col" class="num">检查项</th>
                    <th scope="col" class="num">引用手册</th>
                    <th scope="col" class="num">最近运行</th>
                    <th scope="col">状态</th>
                    <th scope="col"><span class="sr-only">操作</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        <td><a class="table__title" href="@ChecklistHref(row.Id)">@row.Name</a></td>
                        <td>@row.ProjectName</td>
                        <td>@DisplayText.FrequencyText(row.Frequency)</td>
                        <td class="num">@row.ItemCount</td>
                        <td class="num">@row.RunbookRefCount</td>
                        <td class="num">@(row.LastRunAt is { } lastRun ? lastRun.ToLocalTime().ToString("MM-dd HH:mm") : "-")</td>
                        <td>
                            <span class="status-line">
                                @if (row.IsArchived)
                                {
                                    <span class="chip">已归档</span>
                                }
                                else if (row.IsEnabled)
                                {
                                    <span class="chip chip--ok">启用</span>
                                }
                                else
                                {
                                    <span class="chip">停用</span>
                                }
                            </span>
                        </td>
                        <td class="actions">
                            <a class="btn btn--quiet" href="@ChecklistHref(row.Id)">编辑</a>
                            <button type="button" class="btn btn--quiet" @onclick="() => ToggleEnabledAsync(row)">
                                @(row.IsEnabled ? "停用" : "启用")
                            </button>
                            <button type="button" class="btn btn--quiet" @onclick="() => ToggleArchivedAsync(row)">
                                @(row.IsArchived ? "取消归档" : "归档")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="panel" id="new-checklist">
    <h2 class="panel__title">新建检查单</h2>
    @if (projects.Count == 0)
    {
        <p class="panel__copy">还没有项目，请先到 <a href="@SettingsHref">设置</a> 创建项目与环境。</p>
    }
    else
    {
        <div class="form-row">
            <label class="field">
                <span class="field__label">项目</span>
                <select class="select" @bind="newProjectId">
                    <option value="">请选择项目</option>
                    @foreach (var project in projects)
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </select>
            </label>
            <label class="field">
                <span class="field__label">名称</span>
                <input class="input" @bind="newName" placeholder="如：growth 核心链路巡检" />
            </label>
            <label class="field">
                <span class="field__label">频率</span>
                <select class="select" @bind="newFrequencyText">
                    <option value="Manual">手动</option>
                    <option value="Hourly">每小时</option>
                    <option value="Daily">每天</option>
                </select>
            </label>
        </div>
        <div class="actions">
            <button type="button" class="btn btn--primary" @onclick="CreateAsync">创建并编辑</button>
        </div>
    }
</div>

@code {
    private WorkspaceContext workspace = WorkspaceContext.Empty;
    private List<ChecklistView> rows = [];
    private List<ProjectView> projects = [];
    private string newProjectId = "";
    private string newName = "";
    private string newFrequencyText = "Manual";
    private bool showArchived;
    private string? statusMessage;

    private string ContextQuery => workspace.QuerySuffix;
    private string SettingsHref => $"/settings{ContextQuery}";
    private string ScopeLabel => workspace.Current is null
        ? "全部项目"
        : $"{workspace.Current.ProjectName} · 当前项目";
    private int EnabledCount => rows.Count(x => x.IsEnabled && !x.IsArchived);
    private int ItemCount => rows.Sum(x => x.ItemCount);

    protected override async Task OnInitializedAsync()
    {
        await ResolveWorkspaceAsync();
        if (workspace.Current is { } current)
        {
            newProjectId = current.ProjectId.ToString();
        }

        await ReloadAsync();
    }

    private async Task ResolveWorkspaceAsync()
    {
        try
        {
            workspace = await Workspace.ResolveAsync(WorkspaceContextService.ReadQueryValue(Nav));
        }
        catch
        {
            workspace = WorkspaceContext.Empty;
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            var loadedProjects = (await Management.ListProjectsAsync(includeArchived: false, limit: 200)).Items.ToList();
            var loadedChecklists = (await Management.ListChecklistsAsync(
                projectId: workspace.Current?.ProjectId,
                includeArchived: showArchived,
                limit: 200)).Items.ToList();

            // 当前项目存在时，列表与可选项都只保留该项目，避免跨项目串台。
            if (workspace.Current is { } current)
            {
                loadedProjects = loadedProjects.Where(x => x.Id == current.ProjectId).ToList();
                loadedChecklists = loadedChecklists.Where(x => x.ProjectId == current.ProjectId).ToList();
            }

            projects = loadedProjects;
            rows = loadedChecklists;
        }
        catch (ManagementException ex)
        {
            statusMessage = ex.Message;
        }
        catch (Exception ex)
        {
            statusMessage = $"加载失败：{ex.Message}";
        }
    }

    private async Task ToggleEnabledAsync(ChecklistView row)
    {
        await ExecuteAsync(async () =>
        {
            await Management.UpdateChecklistAsync(
                row.Id,
                new UpdateChecklistRequest(row.Name, row.Description, row.Frequency, !row.IsEnabled));
            await ReloadAsync();
        });
    }

    private async Task ToggleArchivedAsync(ChecklistView row)
    {
        await ExecuteAsync(async () =>
        {
            await Management.SetChecklistArchivedAsync(row.Id, !row.IsArchived);
            statusMessage = row.IsArchived ? "检查单已取消归档。" : "检查单已归档。";
            await ReloadAsync();
        });
    }

    private async Task CreateAsync()
    {
        await ExecuteAsync(async () =>
        {
            if (!Guid.TryParse(newProjectId, out var projectId))
            {
                throw new ManagementException("请先选择项目。");
            }

            if (!Enum.TryParse<ChecklistFrequency>(newFrequencyText, out var frequency))
            {
                frequency = ChecklistFrequency.Manual;
            }

            var id = await Management.CreateChecklistAsync(new CreateChecklistRequest(
                projectId,
                newName,
                Frequency: frequency));

            Nav.NavigateTo(ChecklistHref(id));
        });
    }

    private async Task ExecuteAsync(Func<Task> action)
    {
        statusMessage = null;
        try
        {
            await action();
        }
        catch (ManagementException ex)
        {
            statusMessage = ex.Message;
        }
        catch (Exception ex)
        {
            statusMessage = $"操作失败：{ex.Message}";
        }
    }

    private string ChecklistHref(Guid id) => $"/checklists/{id}{ContextQuery}";
}
