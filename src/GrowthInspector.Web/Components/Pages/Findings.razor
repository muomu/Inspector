@page "/findings"
@layout DesignLayout
@inject IDbContextFactory<GrowthInspectorDbContext> DbFactory
@inject WorkspaceContextService Workspace
@inject NavigationManager Nav

<PageTitle>异常 · Growth Inspector</PageTitle>

<header class="page-head">
    <div class="page-head__main">
        <p class="kicker">异常 · Findings</p>
        <h1 class="page-title">异常</h1>
        @if (workspace.Current is not null)
        {
            <p class="page-meta">
                <span>@workspace.Current.ProjectName</span>
                <span>@workspace.Current.EnvironmentName</span>
                @if (loadError is null)
                {
                    <span>@openCount 条未恢复</span>
                    <span>累计 @totalCount 条</span>
                }
            </p>
        }
    </div>
    <div class="page-head__actions">
        <a class="btn btn--quiet" href="@RunsHref">执行历史</a>
    </div>
</header>

@if (loadError is not null)
{
    <p class="alert-line" role="alert"><strong>加载失败</strong><span>@loadError</span></p>
}
else if (workspace.Current is null)
{
    <div class="empty" style="margin-top: 40px;">
        <span class="empty__glyph" aria-hidden="true">◇</span>
        <h2 class="empty__title">还没有项目 / 环境</h2>
        <p class="empty__copy">
            异常跟随当前环境；先到 <a href="/settings">设置</a> 创建项目与环境，再导入检查单并执行一次巡检。
            没有上下文时页面保持空态，不伪造全清。
        </p>
    </div>
}
else
{
    <form class="toolbar" method="get" aria-label="筛选异常">
        <input type="hidden" name="workspace" value="@workspace.Current?.Key" />
        <label class="filter">
            <span class="filter__label">状态</span>
            <select class="select" name="status">
                <option value="all" selected="@(IsStatusSelected("all"))">全部</option>
                <option value="Open" selected="@(IsStatusSelected("Open"))">未恢复</option>
                <option value="Resolved" selected="@(IsStatusSelected("Resolved"))">已恢复</option>
            </select>
        </label>
        <label class="filter">
            <span class="filter__label">级别</span>
            <select class="select" name="severity">
                <option value="" selected="@(IsSeveritySelected(string.Empty))">全部</option>
                @foreach (var severity in Enum.GetValues<Severity>())
                {
                    <option value="@severity" selected="@(IsSeveritySelected(severity.ToString()))">@severity</option>
                }
            </select>
        </label>
        <div class="toolbar__actions">
            <button class="btn btn--primary" type="submit">筛选</button>
            <a class="filter-reset" href="@ResetHref">重置</a>
        </div>
    </form>

    <div class="kpi-grid">
        <div class="kpi">
            <span class="kpi__value">@openCount</span>
            <span class="kpi__label">未恢复</span>
            <span class="kpi__note">当前环境全部严重级</span>
        </div>
        <div class="kpi kpi--warn">
            <span class="kpi__value">@warningOpenCount</span>
            <span class="kpi__label">注意</span>
            <span class="kpi__note">Warning 级未恢复</span>
        </div>
        <div class="kpi kpi--bad">
            <span class="kpi__value">@criticalOpenCount</span>
            <span class="kpi__label">异常</span>
            <span class="kpi__note">Critical 级未恢复</span>
        </div>
        <div class="kpi kpi--pending">
            <span class="kpi__value">@pendingObs</span>
            <span class="kpi__label">待证观察</span>
            <span class="kpi__note">Error / 证据不足，不建 Finding</span>
        </div>
    </div>

    <section class="section" aria-labelledby="s-findings">
        <div class="section__head">
            <span class="section__index">§ 01</span>
            <h2 class="section__title" id="s-findings">异常列表</h2>
            <span class="section__meta">按严重级、最近出现排序</span>
        </div>
        <div class="section__body">
            @if (rows.Count == 0)
            {
                <div class="empty">
                    <span class="empty__glyph" aria-hidden="true">◇</span>
                    @if (totalCount == 0)
                    {
                        <h3 class="empty__title">还没有异常记录</h3>
                        <p class="empty__copy">该环境还没有 Finding；执行链路产生判定后，异常会出现在这里。</p>
                    }
                    else if (IsDefaultOpenFilter)
                    {
                        <h3 class="empty__title">当前没有未恢复异常</h3>
                        <p class="empty__copy">
                            该环境历史上出现过异常，但都已恢复。<a href="@ResolvedHref">查看已恢复的异常</a>
                        </p>
                    }
                    else
                    {
                        <h3 class="empty__title">没有符合筛选条件的异常</h3>
                        <p class="empty__copy"><a href="@ResetHref">清除筛选</a>，或换一个状态 / 级别。</p>
                    }
                </div>
            }
            else
            {
                @foreach (var row in rows)
                {
                    <article class="finding @row.Severity.FindingModifierClass">
                        <span class="finding__severity @row.Severity.SeverityModifierClass">
                            <span aria-hidden="true">@row.Severity.Glyph</span> @row.Severity.Label
                        </span>
                        <div class="finding__main">
                            <h3 class="finding__title">@row.Finding.Title</h3>
                            <p class="finding__meta">
                                @if (!string.IsNullOrWhiteSpace(row.Finding.Message))
                                {
                                    <span>@DisplayText.Shorten(row.Finding.Message, 120)</span>
                                }
                                <span>
                                    检查单 @DisplayText.NameOrMissing(row.Checklist?.Name)
                                    @if (row.Checklist?.Archived == true)
                                    {
                                        <span class="chip">已归档</span>
                                    }
                                </span>
                                <span>
                                    检查项 @DisplayText.NameOrMissing(row.ChecklistItem?.Name)
                                    @if (row.ChecklistItem?.Archived == true)
                                    {
                                        <span class="chip">已归档</span>
                                    }
                                </span>
                                <span>首次 @row.Finding.FirstSeenAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                <span>最近 @row.Finding.LastSeenAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                @if (row.Finding.Status == FindingStatus.Resolved)
                                {
                                    @if (row.Finding.CloseReason is { } closeReason)
                                    {
                                        <span>关闭 @DisplayText.CloseReasonText(closeReason)</span>
                                    }
                                    @if (row.Finding.ResolvedAt is { } resolvedAt)
                                    {
                                        <span>恢复 @resolvedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                    }
                                }
                            </p>
                        </div>
                        <div class="finding__side">
                            <StatusBadge Value="@StatusPresenter.FromFinding(row.Finding.Status, row.Finding.CloseReason)" />
                        </div>
                    </article>
                }

                @if (filteredCount > MaxRows)
                {
                    <p class="note" style="margin-top: 14px;">
                        共 @filteredCount 条符合条件，这里按严重级、最近出现展示前 @MaxRows 条；可用筛选缩小范围。
                    </p>
                }
                <p class="note" style="margin-top: 14px;">
                    Finding 按项目、环境、检查单、检查项去重；恢复后关闭，持续期间只更新。
                </p>
            }
        </div>
    </section>

    <section class="section" aria-labelledby="s-observe">
        <div class="section__head">
            <span class="section__index">§ 02</span>
            <h2 class="section__title" id="s-observe">待证观察</h2>
            <span class="section__meta">
                @if (latestRun is null)
                {
                    <text>无执行记录</text>
                }
                else
                {
                    <text>最近一轮 @latestRun.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @pendingObs 项</text>
                }
            </span>
        </div>
        <div class="section__body">
            @if (latestRun is null)
            {
                <p class="note">
                    该环境还没有执行记录；没有执行就无法产生判定或观察。可以到 <a href="@ChecklistsHref">检查单</a> 手动触发一次巡检。
                </p>
            }
            else if (observations.Count == 0)
            {
                <p class="note">
                    最近一轮没有 Error 或证据不足的结果；观察项只进日报，不建 Finding。
                    <a href="@LatestRunHref">查看本轮执行 →</a>
                </p>
            }
            else
            {
                <div class="table-wrap" role="region" aria-label="本轮待证观察" tabindex="0">
                    <table class="table">
                        <caption class="sr-only">最近一轮执行中 Error 或证据不足的检查项</caption>
                        <thead>
                            <tr>
                                <th scope="col">检查项</th>
                                <th scope="col">综合结果</th>
                                <th scope="col">说明</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in observations)
                            {
                                <tr>
                                    <td class="table__title">
                                        @DisplayText.NameOrMissing(result.ChecklistItem?.Title)
                                        @if (result.ChecklistItem?.IsArchived == true)
                                        {
                                            <span class="chip">已归档</span>
                                        }
                                    </td>
                                    <td>
                                        <StatusBadge Value="@StatusPresenter.FromResult(result.Status, result.ChecklistItem?.Severity, ItemKind(result))" />
                                    </td>
                                    <td>@ObservationText(result)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="note" style="margin-top: 14px;">
                    这些结果不建 Finding、不发 Lark，只在日报观察段出现；待证不是故障，先看执行证据。
                    <a href="@LatestRunHref">查看本轮执行 →</a>
                </p>
            }
        </div>
    </section>

    <section class="section" aria-labelledby="s-health">
        <div class="section__head">
            <span class="section__index">§ 03</span>
            <h2 class="section__title" id="s-health">健康态</h2>
            <span class="section__meta">@HealthMeta</span>
        </div>
        <div class="section__body">
            <div class="@(IsAllHealthy ? "empty empty--ok" : "empty")">
                <span class="empty__glyph" aria-hidden="true">@(IsAllHealthy ? "✓" : "◇")</span>
                @if (IsAllHealthy)
                {
                    <h3 class="empty__title">本次巡检未发现异常</h3>
                    <p class="empty__copy">
                        最近一轮执行已完成，没有未恢复 Finding，也没有 Error / 证据不足；结论只覆盖当前环境。
                        <a href="@LatestRunHref">查看本轮执行 →</a>
                    </p>
                }
                else if (openCount > 0)
                {
                    <h3 class="empty__title">还有未恢复异常</h3>
                    <p class="empty__copy">当前有 @openCount 条未恢复 Finding；处理完后重新执行巡检，这里才会给出全清结论。</p>
                }
                else if (pendingObs > 0)
                {
                    <h3 class="empty__title">还有待证观察</h3>
                    <p class="empty__copy">
                        最近一轮有 @pendingObs 项 Error / 证据不足；待证不是故障，但也不能读作健康，先看执行证据。
                        <a href="@LatestRunHref">查看本轮执行 →</a>
                    </p>
                }
                else if (latestRun is null)
                {
                    <h3 class="empty__title">还没有执行记录</h3>
                    <p class="empty__copy">
                        该环境还没有巡检；没有执行结果时不能给出全清结论。先到 <a href="@ChecklistsHref">检查单</a> 手动触发一次巡检。
                    </p>
                }
                else
                {
                    <h3 class="empty__title">最近一轮没有跑完</h3>
                    <p class="empty__copy">
                        最近一轮执行状态为「@StatusPresenter.FromRun(latestRun.Status).Label」，未完成项按待证处理，不能给出全清结论。
                        <a href="@LatestRunHref">查看本轮执行 →</a>
                    </p>
                }
            </div>
        </div>
    </section>
}

@code {
    private const int MaxRows = 200;

    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusParam { get; set; }

    [SupplyParameterFromQuery(Name = "severity")]
    public string? SeverityParam { get; set; }

    private sealed record NamedState(string Name, bool Archived);

    private sealed record Row(
        Finding Finding,
        NamedState? Checklist,
        NamedState? ChecklistItem,
        StatusPresentation Severity);

    private WorkspaceContext workspace = WorkspaceContext.Empty;
    private List<Row> rows = [];
    private List<CheckResult> observations = [];
    private ChecklistRun? latestRun;
    private int openCount;
    private int totalCount;
    private int warningOpenCount;
    private int criticalOpenCount;
    private int filteredCount;
    private int pendingObs;
    private string? loadError;
    private string statusFilter = "Open";
    private string severityFilter = string.Empty;

    private string ContextQuery => workspace.QuerySuffix;
    private string RunsHref => $"/runs{ContextQuery}";
    private string ChecklistsHref => $"/checklists{ContextQuery}";
    private string ResetHref => $"/findings{ContextQuery}";
    private string ResolvedHref => $"/findings{ContextQuery}{(string.IsNullOrEmpty(ContextQuery) ? "?" : "&")}status=Resolved";
    private string LatestRunHref => latestRun is null ? RunsHref : $"/runs/{latestRun.Id}{ContextQuery}";

    private bool IsAllHealthy => openCount == 0
        && pendingObs == 0
        && latestRun?.Status == RunStatus.Succeeded;

    private bool IsDefaultOpenFilter =>
        statusFilter.Equals("Open", StringComparison.OrdinalIgnoreCase)
        && string.IsNullOrEmpty(severityFilter);

    private string HealthMeta => latestRun is null
        ? "无执行记录"
        : $"最近一轮 {latestRun.StartedAt.ToLocalTime():yyyy-MM-dd HH:mm} · {StatusPresenter.FromRun(latestRun.Status).Label}";

    protected override async Task OnInitializedAsync()
    {
        ParseFilters();
        try
        {
            workspace = await Workspace.ResolveAsync(WorkspaceContextService.ReadQueryValue(Nav));
            if (workspace.Current is null)
            {
                return;
            }

            var environmentId = workspace.Current.EnvironmentId;
            await using var db = await DbFactory.CreateDbContextAsync();

            var scopedFindings = db.Findings
                .AsNoTracking()
                .Where(x => x.EnvironmentId == environmentId);

            openCount = await scopedFindings.CountAsync(x => x.Status == FindingStatus.Open);
            totalCount = await scopedFindings.CountAsync();
            warningOpenCount = await scopedFindings.CountAsync(
                x => x.Status == FindingStatus.Open && x.Severity == Severity.Warning);
            criticalOpenCount = await scopedFindings.CountAsync(
                x => x.Status == FindingStatus.Open && x.Severity == Severity.Critical);

            IQueryable<Finding> query = scopedFindings;
            if (!statusFilter.Equals("all", StringComparison.OrdinalIgnoreCase))
            {
                var status = Enum.Parse<FindingStatus>(statusFilter);
                query = query.Where(x => x.Status == status);
            }

            if (!string.IsNullOrEmpty(severityFilter))
            {
                var severity = Enum.Parse<Severity>(severityFilter);
                query = query.Where(x => x.Severity == severity);
            }

            filteredCount = await query.CountAsync();
            // 枚举在 SQLite 里落成 TEXT，直接按列排序会变成字典序；用数值权重显式降序。
            var findings = await query
                .OrderByDescending(x => x.Severity == Severity.Critical ? 3 : x.Severity == Severity.Warning ? 2 : 1)
                .ThenByDescending(x => x.LastSeenAt)
                .Take(MaxRows)
                .ToListAsync();

            var checklistIds = findings.Select(x => x.ChecklistId).Distinct().ToList();
            var itemIds = findings.Select(x => x.ChecklistItemId).Distinct().ToList();

            var checklists = await db.Checklists
                .Where(x => checklistIds.Contains(x.Id))
                .Select(x => new { x.Id, x.Name, x.IsArchived })
                .AsNoTracking()
                .ToListAsync();
            var items = await db.ChecklistItems
                .Where(x => itemIds.Contains(x.Id))
                .Select(x => new { x.Id, x.Title, x.IsArchived })
                .AsNoTracking()
                .ToListAsync();

            var checklistMap = checklists.ToDictionary(x => x.Id, x => new NamedState(x.Name, x.IsArchived));
            var itemMap = items.ToDictionary(x => x.Id, x => new NamedState(x.Title, x.IsArchived));

            rows = findings
                .Select(x => new Row(
                    x,
                    checklistMap.GetValueOrDefault(x.ChecklistId),
                    itemMap.GetValueOrDefault(x.ChecklistItemId),
                    StatusPresenter.FromSeverity(x.Severity)))
                .ToList();

            latestRun = await db.ChecklistRuns
                .Where(x => x.EnvironmentId == environmentId)
                .Include(x => x.Checklist)
                .Include(x => x.Results)
                .ThenInclude(x => x.ChecklistItem)
                .OrderByDescending(x => x.StartedAt)
                .AsNoTracking()
                .FirstOrDefaultAsync();

            observations = latestRun is null
                ? []
                : latestRun.Results
                    // 只把处于「待证」态的检查项算作待证观察（证据不足 / 执行出错）。
                    .Where(x => StatusPresenter
                        .FromResult(x.Status, x.ChecklistItem?.Severity, ItemKind(x))
                        .State == StatusState.Pending)
                    .OrderByDescending(x => x.Status)
                    .ThenBy(x => x.ChecklistItem?.SortOrder ?? int.MaxValue)
                    .ToList();
            pendingObs = observations.Count;
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    private void ParseFilters()
    {
        if (string.IsNullOrWhiteSpace(StatusParam))
        {
            statusFilter = "Open";
        }
        else if (StatusParam.Equals("all", StringComparison.OrdinalIgnoreCase))
        {
            statusFilter = "all";
        }
        else if (Enum.TryParse<FindingStatus>(StatusParam, ignoreCase: true, out var status))
        {
            statusFilter = status.ToString();
        }
        else
        {
            statusFilter = "Open";
        }

        severityFilter = Enum.TryParse<Severity>(SeverityParam, ignoreCase: true, out var severity)
            ? severity.ToString()
            : string.Empty;
    }

    private bool IsStatusSelected(string value)
        => statusFilter.Equals(value, StringComparison.OrdinalIgnoreCase);

    private bool IsSeveritySelected(string value)
        => severityFilter.Equals(value, StringComparison.OrdinalIgnoreCase);

    private static StatusItemKind ItemKind(CheckResult result) => StatusItemKind.Judgement;

    private static string ObservationText(CheckResult result)
        => DisplayText.Shorten(result.Narrative ?? result.ErrorMessage, 140);
}
