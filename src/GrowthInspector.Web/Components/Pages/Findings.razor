@page "/findings"
@inject IDbContextFactory<GrowthInspectorDbContext> DbFactory

<PageTitle>异常 · Growth Inspector</PageTitle>

<h1>异常</h1>
<p class="page-subtitle">
    finding 按 (Project, Environment, 检查单, 检查项) 去重：新异常与恢复各通知一次，持续期间只进日报。
    去重与告警由 TPG-2713 接入。
</p>

@if (rows.Count == 0)
{
    <div class="empty">还没有异常。执行链路接入后，判定型检查项异常会在这里出现。</div>
}
else
{
    <table class="data">
        <thead>
            <tr>
                <th>级别</th>
                <th>标题</th>
                <th>项目 / 环境</th>
                <th>检查单 / 检查项</th>
                <th>首次</th>
                <th>最近</th>
                <th>状态</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in rows)
            {
                <tr>
                    <td><span class="badge">@row.Severity</span></td>
                    <td>@row.Title</td>
                    <td>@row.ProjectName / @row.EnvironmentName</td>
                    <td>@row.ChecklistName / @row.ItemTitle</td>
                    <td>@row.FirstSeenAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                    <td>@row.LastSeenAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                    <td>@(row.Status == FindingStatus.Open ? "未恢复" : "已恢复")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private sealed record Row(
        Severity Severity,
        string Title,
        string ProjectName,
        string EnvironmentName,
        string ChecklistName,
        string ItemTitle,
        DateTimeOffset FirstSeenAt,
        DateTimeOffset LastSeenAt,
        FindingStatus Status);

    private List<Row> rows = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        rows = await (from finding in db.Findings
                      join environment in db.Environments on finding.EnvironmentId equals environment.Id
                      join project in db.Projects on finding.ProjectId equals project.Id
                      join checklist in db.Checklists on finding.ChecklistId equals checklist.Id
                      join item in db.ChecklistItems on finding.ChecklistItemId equals item.Id
                      orderby finding.Status, finding.LastSeenAt descending
                      select new Row(
                          finding.Severity,
                          finding.Title,
                          project.Name,
                          environment.Name,
                          checklist.Name,
                          item.Title,
                          finding.FirstSeenAt,
                          finding.LastSeenAt,
                          finding.Status))
            .AsNoTracking()
            .Take(200)
            .ToListAsync();
    }
}
