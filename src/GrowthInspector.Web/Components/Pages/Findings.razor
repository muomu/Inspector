@page "/findings"
@layout DesignLayout
@inject NavigationManager Nav

<PageTitle>异常 · Growth Inspector</PageTitle>
<p class="note" style="margin-top: 40px;">异常列表已并入总览「需要处理」，正在跳转…</p>

@code {
    /// <summary>
    /// 异常页退役后的落点：列表在总览 § 02，详情在 /findings/{id}。
    /// forceLoad 让浏览器自己处理 #s-findings 锚点，交互式导航不滚锚点。
    /// </summary>
    protected override void OnInitialized()
    {
        var query = new Uri(Nav.Uri).Query;
        Nav.NavigateTo($"/{query}#s-findings", forceLoad: true);
    }
}
