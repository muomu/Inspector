@page "/Error"
@layout DesignLayout
@using System.Diagnostics

<PageTitle>出错了 · Growth Inspector</PageTitle>

<header class="page-head">
    <div class="page-head__main">
        <p class="kicker">Error · 页面异常</p>
        <h1 class="page-title">页面发生异常</h1>
        <p class="page-meta">
            <span>异常已记录，不影响已落库的巡检结果</span>
            @if (ShowRequestId)
            {
                <span>Request ID: @RequestId</span>
            }
        </p>
    </div>
    <div class="page-head__actions">
        <a class="btn btn--quiet" href="/">回到总览</a>
    </div>
</header>

<div class="callout callout--alert" style="margin-top: 40px;">
    <h2 class="callout__title">请求没有完成</h2>
    <p class="callout__copy">
        处理这次请求时发生了未处理异常。异常不会改变已写入的执行结果与 Finding；
        可重新加载页面，或回到总览查看最近一轮巡检。
    </p>
</div>

<section class="section" aria-labelledby="s-error-dev">
    <div class="section__head">
        <span class="section__index">§ 01</span>
        <h2 class="section__title" id="s-error-dev">开发模式</h2>
        <span class="section__meta">仅本地排查用</span>
    </div>
    <div class="section__body">
        <p class="note">
            把环境切到 <strong>Development</strong> 会显示更详细的异常信息。已部署的应用不要开启
            Development —— 它可能把异常细节和敏感信息暴露给最终用户。本地调试时设置
            <code>ASPNETCORE_ENVIRONMENT=Development</code> 并重启应用即可。
        </p>
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
