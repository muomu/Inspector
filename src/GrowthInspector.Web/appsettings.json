{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Inspector": {
    "AuditRetentionDays": 90,
    "ToolResultMaxBytes": 8192,
    "MaxConcurrentChecklists": 4,
    "SchedulerTickSeconds": 30,
    "HourlyScheduleMinute": 0,
    "DailyScheduleTime": "10:00",
    "AgentMaxTurns": 12,
    "AgentItemTimeoutSeconds": 180,
    "RunbookSearchLimit": 5,
    "TimeZone": "Asia/Shanghai"
  },
  "DeepSeek": {
    "BaseUrl": "https://api.deepseek.com",
    "Model": "deepseek-flash",
    "SummaryModel": "deepseek-flash",
    "ThinkingForExecution": false,
    "ThinkingForSummary": true,
    "TimeoutSeconds": 120
  },
  "ManagementMcp": {
    "Enabled": true,
    "Path": "/mcp",
    "BindAddress": "127.0.0.1",
    "TokenEnvironmentVariable": "INSPECTOR_MCP_TOKEN",
    "ConfigWriteEnvironmentVariable": "INSPECTOR_MCP_CONFIG_WRITE",
    "AdminWriteEnvironmentVariable": "INSPECTOR_MCP_ADMIN_WRITE",
    "AllowedOrigins": [
      "http://localhost:5273",
      "http://127.0.0.1:5273"
    ]
  }
}
